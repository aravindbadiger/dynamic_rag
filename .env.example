# =============================================================================
# Dynamic Embedding RAG — Environment Variables
# =============================================================================
# Copy this file to .env.local (local dev) or .env.docker (Docker) and
# fill in your values. Do NOT commit .env.local or .env.docker to git.
# =============================================================================

# -- Qdrant --
QDRANT_HOST=localhost                       # use "qdrant" for Docker
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=dynamic-rag
USE_QDRANT_SERVER=true

# -- Ollama --
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=localhost                       # use "ollama" for Docker
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434      # use "http://ollama:11434" for Docker

# -- Embedding --
EMBEDDING_MODEL=all-MiniLM-L6-v2

# -- Chunking --
CHUNK_MAX_CHARS=512
CHUNK_MIN_CHARS=64
CHUNK_OVERLAP=50

# -- RAG search --
SEARCH_THRESHOLD=0.5
TOP_K_RESULTS=5

# -- Gradio UI --
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7861
GRADIO_SHARE=false

# -- OpenAI (optional) --
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# -- GitHub Copilot (optional) --
GITHUB_TOKEN=
GHCP_MODEL=gpt-4o
GHCP_BASE_URL=https://models.inference.ai.azure.com
